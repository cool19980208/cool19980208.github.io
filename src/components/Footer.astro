---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex flex-wrap items-center justify-center gap-x-1 gap-y-1 text-sm">
      <a href="https://magic.ly/ZaneRen" target="_blank" rel="noopener" class="hover:text-accent">Magic.ly</a>
      <span class="opacity-50">·</span>
      <a href="https://cal.com/ZaneRen" target="_blank" rel="noopener" class="hover:text-accent">Cal.com</a>
      <span class="opacity-50">·</span>
      <a href="https://onee.page/cool" target="_blank" rel="noopener" class="hover:text-accent">Onee.page</a>
    </div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear} Cool's Blog</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>用心记录，持续分享</span>
    </div>
  </div>
</footer>
